   gandiva::ExecutionContext context;
   auto context_ptr = reinterpret_cast<int64_t>(&context);
   auto len_ist = static_cast<gdv_int32>(strlen("Asia/Kolkata"));
@@ -1300,7 +1300,7 @@ TEST(TestGdvFnStubs, TestToUtcTimezone) {
