From: =?UTF-8?q?Ra=C3=BAl=20Cumplido?= <raulcumplido@gmail.com>
Subject: [PATCH] Restore CMAKE_MODULE_PATH after finding ORC

orcConfig.cmake overwrites CMAKE_MODULE_PATH and doesn't restore it when
one of its dependencies isn't found, because find_dependency() calls
return() in the config file. Every later lookup relying on Arrow's Find
modules (e.g. FindAWSSDKAlt.cmake) then fails.
---
diff --git a/cpp/cmake_modules/FindorcAlt.cmake b/cpp/cmake_modules/FindorcAlt.cmake
index ce8cd11b4c..38c4a76746 100644
--- a/cpp/cmake_modules/FindorcAlt.cmake
+++ b/cpp/cmake_modules/FindorcAlt.cmake
@@ -26,7 +26,13 @@ endif()
 if(orcAlt_FIND_QUIETLY)
   list(APPEND find_package_args QUIET)
 endif()
+# orcConfig.cmake overwrites CMAKE_MODULE_PATH and doesn't restore it
+# when one of its dependencies isn't found because find_dependency()
+# calls return() in the config file.
+set(orcAlt_CMAKE_MODULE_PATH_KEEP "${CMAKE_MODULE_PATH}")
 find_package(orc ${find_package_args})
+set(CMAKE_MODULE_PATH "${orcAlt_CMAKE_MODULE_PATH_KEEP}")
+unset(orcAlt_CMAKE_MODULE_PATH_KEEP)
 if(orc_FOUND)
   set(orcAlt_FOUND TRUE)
   set(orcAlt_VERSION ${orc_VERSION})
